{
  "$comment": "Input/expected pairs for transliterate(). Every implementation (TS, Kotlin, Swift) must pass all of them. Add a case here, never only in a platform test.",
  "cases": [
    { "group": "readme", "input": "Sain baina uu", "expected": "Сайн байна уу" },
    { "group": "readme", "input": "MONGOL", "expected": "МОНГОЛ" },
    { "group": "readme", "input": "gov'", "expected": "говь" },
    { "group": "readme", "input": "Minii mergejil *Programmer*", "expected": "Миний мэргэжил Programmer" },

    { "group": "digraphs", "input": "bayarlalaa", "expected": "баярлалаа" },
    { "group": "digraphs", "input": "yaagaad", "expected": "яагаад" },
    { "group": "digraphs", "input": "qnqqdqr", "expected": "өнөөдөр" },
    { "group": "digraphs", "input": "wgwi", "expected": "үгүй" },
    { "group": "digraphs", "input": "heregtei", "expected": "хэрэгтэй" },
    { "group": "digraphs", "input": "tsetserleg", "expected": "цэцэрлэг" },
    { "group": "digraphs", "input": "shine", "expected": "шинэ" },
    { "group": "digraphs", "input": "borshch", "expected": "борщ" },
    { "group": "digraphs", "input": "yum", "expected": "юм" },
    { "group": "digraphs", "input": "goyo", "expected": "гоё" },
    { "group": "digraphs", "input": "yerqnhii", "expected": "ерөнхий" },
    { "group": "digraphs", "input": "guai", "expected": "гуай" },

    { "group": "long-vowel-then-i", "note": "A doubled vowel is consumed first, so the i after it is и, not й. Neither ааи nor аай occurs in Mongolian; this pins the current behavior so a table reorder is noticed.", "input": "aai", "expected": "ааи" },
    { "group": "long-vowel-then-i", "input": "uui", "expected": "ууи" },
    { "group": "long-vowel-then-i", "input": "ooi", "expected": "оои" },
    { "group": "long-vowel-then-i", "input": "qqi", "expected": "өөи" },
    { "group": "long-vowel-then-i", "input": "eei", "expected": "ээи" },
    { "group": "long-vowel-then-i", "input": "iii", "expected": "ийи" },

    { "group": "yi", "input": "mongolyin", "expected": "монголын" },
    { "group": "yi", "input": "ulsyin", "expected": "улсын" },
    { "group": "yi", "input": "Yi", "expected": "Ы" },
    { "group": "yi", "input": "MONGOLYIN", "expected": "МОНГОЛЫН" },
    { "group": "yi", "input": "yiy", "expected": "ый" },

    { "group": "umlaut", "input": "Mönh", "expected": "Мөнх" },
    { "group": "umlaut", "input": "önöödör", "expected": "өнөөдөр" },
    { "group": "umlaut", "input": "ügüi", "expected": "үгүй" },
    { "group": "umlaut", "input": "ÜNEN", "expected": "ҮНЭН" },
    { "group": "umlaut", "input": "Ö", "expected": "Ө" },
    { "group": "umlaut", "input": "GOV’ ÜÜ", "expected": "ГОВЬ ҮҮ" },
    { "group": "umlaut", "note": "o + combining diaeresis is composed before lookup", "input": "mönh", "expected": "мөнх" },
    { "group": "umlaut", "note": "but literal sections are returned byte for byte", "input": "*ö*", "expected": "ö" },
    { "group": "umlaut", "input": "ö_i", "expected": "өи" },

    { "group": "separator", "input": "unt_san", "expected": "унтсан" },
    { "group": "separator", "input": "mart_san", "expected": "мартсан" },
    { "group": "separator", "input": "Bat_saihan", "expected": "Батсайхан" },
    { "group": "separator", "input": "y_ogurt", "expected": "йогурт" },
    { "group": "separator", "input": "UNT_SAN", "expected": "УНТСАН" },
    { "group": "separator", "note": "not between two letters: left alone", "input": "a _ b", "expected": "а _ б" },
    { "group": "separator", "input": "___", "expected": "___" },
    { "group": "separator", "input": "_a", "expected": "_а" },
    { "group": "separator", "input": "a_", "expected": "а_" },
    { "group": "separator", "input": "*snake_case*", "expected": "snake_case" },

    { "group": "apostrophes", "note": "phone smart punctuation", "input": "gov’", "expected": "говь" },
    { "group": "apostrophes", "input": "gov‘", "expected": "говь" },
    { "group": "apostrophes", "input": "ob’’yekt", "expected": "объект" },
    { "group": "apostrophes", "input": "ob'’yekt", "expected": "объект" },

    { "group": "casing", "input": "SAIN BAINA UU", "expected": "САЙН БАЙНА УУ" },
    { "group": "casing", "input": "Sain", "expected": "Сайн" },
    { "group": "casing", "input": "sain", "expected": "сайн" },
    { "group": "casing", "input": "Tsagaan", "expected": "Цагаан" },
    { "group": "casing", "input": "TSAGAAN", "expected": "ЦАГААН" },
    { "group": "casing", "input": "Shine", "expected": "Шинэ" },
    { "group": "casing", "input": "SHINE", "expected": "ШИНЭ" },
    { "group": "casing", "input": "Yu", "expected": "Ю" },
    { "group": "casing", "note": "soft/hard sign follow the word's case", "input": "GOV'", "expected": "ГОВЬ" },
    { "group": "casing", "input": "Gov'", "expected": "Говь" },
    { "group": "casing", "input": "OB''YEKT", "expected": "ОБЪЕКТ" },
    { "group": "casing", "input": "GOV’ HONI", "expected": "ГОВЬ ХОНИ" },
    { "group": "casing", "note": "a single capital is title case, not all caps", "input": "A", "expected": "А" },
    { "group": "casing", "input": "I", "expected": "И" },

    { "group": "passthrough", "input": "1990 on, 5-r sar!", "expected": "1990 он, 5-р сар!" },
    { "group": "passthrough", "input": "sain\nbaina\r\nuu\tta", "expected": "сайн\nбайна\r\nуу\tта" },
    { "group": "passthrough", "input": "Сайн uu", "expected": "Сайн уу" },
    { "group": "passthrough", "input": "a@b.mn", "expected": "а@б.мн" },
    { "group": "passthrough", "input": "", "expected": "" },
    { "group": "passthrough", "note": "İ lowercases to two code units; must not shift the index", "input": "İsain", "expected": "İсайн" },
    { "group": "passthrough", "input": "ßain", "expected": "ßайн" },

    { "group": "escape", "note": "unmatched star is a normal character", "input": "5*3 = 15", "expected": "5*3 = 15" },
    { "group": "escape", "input": "sain *baina", "expected": "сайн *байна" },
    { "group": "escape", "note": "empty ** is dropped", "input": "sain ** uu", "expected": "сайн  уу" },
    { "group": "escape", "input": "*A* ba *B*", "expected": "A ба B" }
  ]
}
