# --- AI Polish (Gemini) ------------------------------------------------------
# Get a key from https://aistudio.google.com/apikey (free tier is fine)
GEMINI_API_KEY=

# --- Rate limiting (Upstash Redis) -------------------------------------------
# Create a free Redis DB at https://console.upstash.com/
# Copy the "REST URL" and "REST TOKEN" from the database page.
# In local dev these can be left blank — the API will fail open (no IP limit),
# but the client-side localStorage cap still applies. In production both MUST
# be set or /api/polish returns 500 NOT_CONFIGURED.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
